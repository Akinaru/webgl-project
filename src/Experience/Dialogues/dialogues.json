                {
                  "type": "addMetier",
                  "metier": "MENEUR",
                  "amount": 5
                }
              ]
            },
            {
              "id": "distribution_001_choice_travailleur",
              "text": "Les ouvriers dans l’industrie.",
              "next": "distribution_002",
              "actions": [
                {
                  "type": "addMetier",
                  "metier": "TRAVAILLEUR",
                  "amount": 4
                }
              ]
            },
            {
              "id": "distribution_001_choice_botaniste",
              "text": "Les jardins et les animaux.",
              "next": "distribution_002",
              "actions": [
                {
                  "type": "addMetier",
                  "metier": "BOTANISTE",
                  "amount": 4
                }
              ]
            }
          ]
        },
        "distribution_002": {
          "type": "line",
          "speaker": "Bloom",
          "text": "Mmhh intéressant ce choix. Maintenant ouvre les vannes et répartie l’eau pour l’agriculture, les foyers, et l’industrie.",
          "next": "distribution_003",
          "actions": []
        },
        "distribution_003": {
          "type": "line",
          "speaker": "Bloom",
          "text": "Mais attention à la goutte d’eau qui fait déborder le vase : chaque dépassement de quota est un déséquilibre.",
          "next": "distribution_004",
          "actions": []
        },
        "distribution_004": {
          "type": "line",
          "speaker": "Bloom",
          "text": "Distribue l’eau et quand tu penses avoir fait la meilleure répartition, clique sur le bouton valider.",
          "next": "distribution_end",
          "actions": []
        },
        "distribution_005": {
          "type": "line",
          "speaker": "Bloom",
          "text": "Wahou, bravo à toi ! Toutes les étapes sont finies ! Allons dans la salle finale pour te parler de ton intégration dans Altera !",
          "next": "distribution_end",
          "actions": []
        },
        "distribution_end": {
          "type": "end",
          "actions": []
        }
      }
    },
    "resultat": {
      "key": "resultat",
      "once": false,
      "startNode": "resultat_001",
      "nodes": {
        "resultat_001": {
          "type": "line",
          "speaker": "Bloom",
          "text": "Tu as terminé ta visite. Et maintenant… voici la vérité : chaque choix que tu as fait, chaque geste, chaque hesitation… tout cela a dessiné ton profil. Tu n’as pas passé un test. Tu t’es révélé.",
          "next": "resultat_002",
          "actions": []
        },
        "resultat_002": {
          "type": "line",
          "speaker": "Bloom",
          "text": "Voici ton rôle dans Altera :",
          "next": "resultat_role_branch",
          "actions": []
        },
        "resultat_role_branch": {
          "type": "branch",
          "branches": [
            {
              "conditions": [
                {
                  "type": "metierIsMax",
                  "metier": "INVENTEUR"
                }
              ],
              "next": "resultat_002_inventeur"
            },
            {
              "conditions": [
                {
                  "type": "metierIsMax",
                  "metier": "TRAVAILLEUR"
                }
              ],
              "next": "resultat_002_travailleur"
            },
            {
              "conditions": [
                {
                  "type": "metierIsMax",
                  "metier": "BOTANISTE"
                }
              ],
              "next": "resultat_002_botaniste"
            },
            {
              "conditions": [
                {
                  "type": "metierIsMax",
                  "metier": "MENEUR"
                }
              ],
              "next": "resultat_002_meneur"
            }
          ],
          "fallbackNext": "resultat_002_inventeur"
        },
        "resultat_002_inventeur": {
          "type": "line",
          "speaker": "Bloom",
          "text": "Tu es celui qui imagine les solutions de demain. Qui analyse, qui innove, qui construit les circuits de l’avenir.\nBienvenue, Inventeur. Altera a besoin de ton esprit.",
          "next": "resultat_end",
          "actions": [
            {
              "type": "showDistributionResult",
              "metier": "INVENTEUR"
            }
          ]
        },
        "resultat_002_travailleur": {
          "type": "line",
          "speaker": "Bloom",
          "text": "Tu es celui qui met les mains dans le cambouis. Qui installe, qui vide, qui transporte. Sans toi, rien ne fonctionne.\nBienvenue, Travailleur. Altera repose sur tes épaules.",
          "next": "resultat_end",
          "actions": [
            {
              "type": "showDistributionResult",
              "metier": "TRAVAILLEUR"
            }
          ]
        },
        "resultat_002_botaniste": {
          "type": "line",
          "speaker": "Bloom",
          "text": "Tu es celui qui écoute la nature. Qui plante, qui trie, qui protège la faune et la flore.\nBienvenue, Botaniste. Altera respire grâce à toi.",
