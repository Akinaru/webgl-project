        "recuperation_014": {
          "type": "line",
          "speaker": "Bloom",
          "text": "Aide-moi à orienter les tuyaux pour acheminer l’eau de la manière la plus fluide possible.\nPour toi, le meilleur chemin, c’est quoi ?",
          "next": "recuperation_014_choice",
          "actions": []
        },
        "recuperation_014_choice": {
          "type": "choice",
          "choices": [
            {
              "id": "recuperation_014_choice_botaniste",
              "text": "Le plus organique",
              "next": "recuperation_015",
