  "dialogues": {
    "intro": {
      "key": "intro",
      "once": false,
      "startNode": "intro_001",
      "nodes": {
        "intro_end": {
          "type": "end",
          "actions": []
        },
        "intro_001": {
          "type": "line",
          "speaker": "Bloom",
          "text": "Bonjour… Je m’appelle Bloom ! Je sais que tu es là parce que le monde a changé. Parce que l’eau, autrefois banale, est devenue rare et précieuse.",
          "next": "intro_002",
          "actions": []
        },
        "intro_002": {
          "type": "line",
          "speaker": "Bloom",
          "text": "Après la privation des ressources en 2039 à cause des villes-marques, nous avons compris trop tard : on ne peut pas traiter l’eau comme un produit. ",
          "next": "intro_003",
          "actions": []
        },
        "intro_003": {
          "type": "line",
          "speaker": "Bloom",
          "text": "Aujourd’hui en 2050, elle n’est pas à vendre. Elle est à partager. À protéger.",
          "next": "intro_004",
          "actions": []
        },
        "intro_004": {
          "type": "line",
          "speaker": "Bloom",
          "text": "Alors, nous avons bâti Altera, une société où chaque geste compte, où chaque personne à un rôle à jouer et trouve sa place non pas par hasard, mais par essence. ",
          "next": "intro_005",
          "actions": []
        },
        "intro_005": {
          "type": "line",
          "speaker": "Bloom",
          "text": "Toi, apprenti-citoyen, tu vas découvrir comment nous vivons, comment nous pensons, et comment nous survivons, tous ensemble. Mais dis-moi, pour toi, l’eau c’est surtout quoi ?",
          "next": "intro_005_choice",
          "actions": []
        },
        "intro_005_choice": {
          "type": "choice",
          "choices": [
            {
              "id": "intro_005_choice_travailleur",
              "text": "Un outil vital.",
              "next": "intro_006",
              "actions": [
                {
                  "type": "addMetier",
                  "metier": "TRAVAILLEUR",
                  "amount": 3
                }
              ]
            },
            {
              "id": "intro_005_choice_inventeur",
              "text": "Un mystère à comprendre.",
              "next": "intro_006",
              "actions": [
                {
                  "type": "addMetier",
                  "metier": "INVENTEUR",
                  "amount": 4
                }
              ]
            },
            {
              "id": "intro_005_choice_meneur",
              "text": "Une responsabilité à gérer.",
              "next": "intro_006",
              "actions": [
                {
                  "type": "addMetier",
                  "metier": "MENEUR",
                  "amount": 3
                }
              ]
            },
            {
              "id": "intro_005_choice_botaniste",
              "text": "Un cadeau de la nature.",
              "next": "intro_006",
              "actions": [
                {
                  "type": "addMetier",
                  "metier": "BOTANISTE",
                  "amount": 4
                }
              ]
            }
          ]
        },
        "intro_006": {
          "type": "line",
          "speaker": "Bloom",
          "text": "D’accord ! Alors on se jette à l’eau ! Le parcours se fera en 3 grandes étapes : la récupération de l’eau, le recyclage et la distribution.",
          "next": "intro_007",
          "actions": []
        },
        "intro_007": {
          "type": "line",
          "speaker": "Bloom",
          "text": "Tu es prêt ? Alors suis-moi dans le bâtiment de récupération d’eau !",
          "next": "intro_end",
          "actions": []
        }
      }
    },
    "recuperation_0": {
      "key": "recuperation_0",
      "once": false,
      "startNode": "recuperation_001",
      "nodes": {
        "recuperation_001": {
          "type": "line",
          "speaker": "Bloom",
          "text": "Voici la station de test. Ici, les matériaux ne sont pas juste beaux, ils sont intelligents. \nChaque matériau choisit comment il veut récupérer la pluie.",
          "next": "recuperation_002",
          "actions": []
        },
        "recuperation_002": {
          "type": "line",
          "speaker": "Bloom",
          "text": "Toi, ton rôle coule de source : tu vas décider du meilleur matériau à utiliser pour les bâtiments du quartier.",
          "next": "recuperation_003",
          "actions": []
        },
        "recuperation_003": {
          "type": "line",
          "speaker": "Bloom",
          "text": "La carapace de scarabée ? Le verre ? Ou la végétation ?",
          "next": "recuperation_004",
          "actions": []
        },
        "recuperation_004": {
          "type": "line",
          "speaker": "Bloom",
          "text": "Choisis un matériau et simules la pluie pour trouver le meilleur pour récupérer l’eau. Une fois que ton choix est fait, clique sur le bouton “Valider”.",
          "next": "recuperation_end",
          "actions": []
        },
        "recuperation_end": {
          "type": "end",
          "actions": []
        }
      }
    },
