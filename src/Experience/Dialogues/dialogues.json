        "distribution_001": {
          "type": "line",
          "speaker": "Bloom",
          "text": "Ahh la dernière étape, nous voyons le bout du tuyau !\nMaintenant, l’eau est propre. Il faut la donner. Mais en cas de pénurie d'eau, tu priorises qui ?",
          "next": "distribution_001_choice",
