    "recyclage_1": {
      "key": "recyclage_1",
      "once": false,
      "startNode": "recyclage_101",
      "nodes": {
        "recyclage_101": {
          "type": "line",
          "speaker": "Bloom",
          "text": "Voici nos petits héros invisibles. \nIls nettoient l’eau… mais parfois, ils se salissent eux-mêmes. Et là, c’est à toi d’intervenir. \nQuel serait ton premier réflexe si un objet etait endommagé?",
          "next": "recyclage_101_choice",
          "actions": []
        },
        "recyclage_101_choice": {
          "type": "choice",
          "choices": [
            {
              "id": "recyclage_101_choice_inventeur",
              "text": "Trouver une astuce",
              "next": "recyclage_102",
              "actions": [
                {
                  "type": "addMetier",
                  "metier": "INVENTEUR",
                  "amount": 5
                }
              ]
            },
            {
              "id": "recyclage_101_choice_botaniste",
              "text": "Prendre soin de l'objet",
              "next": "recyclage_102",
              "actions": [
                {
                  "type": "addMetier",
                  "metier": "BOTANISTE",
                  "amount": 4
                }
              ]
            },
            {
              "id": "recyclage_101_choice_travailleur",
              "text": "Agir vite",
              "next": "recyclage_102",
              "actions": [
                {
                  "type": "addMetier",
                  "metier": "TRAVAILLEUR",
                  "amount": 4
                }
              ]
            }
          ]
        },
        "recyclage_102": {
          "type": "line",
          "speaker": "Bloom",
          "text": "Devant cette borne, utilise tes mains, pour essuyer les taches sur les nanobots.",
          "next": "recyclage_103",
          "actions": []
        },
        "recyclage_103": {
          "type": "line",
          "speaker": "Bloom",
          "text": "Une fois que tu penses avoir finit de nettoyer le nanobot, pense à le renvoyer à son travail car il est essentiel à la vie d’Altera.",
          "next": "recyclage_104",
          "actions": []
        },
        "recyclage_104": {
          "type": "line",
          "speaker": "Bloom",
          "text": "J’espère que c’était clair comme de l’eau de roche. Aller hop hop hop, au travail !",
          "next": "recyclage_105",
          "actions": []
        },
        "recyclage_105": {
          "type": "line",
          "speaker": "Bloom",
          "text": "Super ! Grâce à toi l’eau peut se recycler à l’infini ! Il ne nous reste plus qu’à la distribuer à tout le monde !",
          "next": "recyclage_1_end",
          "actions": []
        },
        "recyclage_1_end": {
          "type": "end",
          "actions": []
        }
      }
    },
    "recyclage_0": {
      "key": "recyclage_0",
      "once": false,
      "startNode": "recyclage_001",
      "nodes": {
        "recyclage_001": {
          "type": "line",
          "speaker": "Bloom",
          "text": "Bon continuons notre parcours au fil de l'eau.",
          "next": "recyclage_002",
          "actions": []
        },
        "recyclage_002": {
          "type": "line",
          "speaker": "Bloom",
          "text": "Ici dans la salle du recyclage, l’eau sale ne part pas à l’égout.\nElle revient à la terre grâce aux champignons filtres que tu vas planter.",
          "next": "recyclage_003",
          "actions": []
        },
        "recyclage_003": {
          "type": "line",
          "speaker": "Bloom",
          "text": "Ils mangent les polluants, et en retour, ils brillent. \nPlace-les aux bons endroits et n’aie pas peur de toucher et de cliquer pour les faire briller.",
          "next": "recyclage_004",
          "actions": []
        },
        "recyclage_004": {
          "type": "line",
          "speaker": "Bloom",
          "text": "Wahou, c’est super, tu t’en es sorti comme un poisson dans l’eau ! Je suis fière de toi.",
          "next": "recyclage_005",
          "actions": []
        },
        "recyclage_005": {
          "type": "line",
          "speaker": "Bloom",
          "text": "Allons dans la seconde pièce du recyclage : le recyclage avec les nanobots !",
          "next": "recyclage_0_end",
          "actions": []
        },
        "recyclage_0_end": {
          "type": "end",
          "actions": []
        }
      }
    },
    "distribution": {
      "key": "distribution",
      "once": false,
      "startNode": "distribution_phase_branch",
      "nodes": {
        "distribution_phase_branch": {
